---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
---
<Layout
  title="High Voltage Insights"
  seoTitle="HV Cable Termination Technology | High Voltage Insights"
  description="Independent-format technical coverage of high-voltage cable termination — materials, methods, and standards. Published by Reynard."
>
  <p class="eyebrow">Independent-format HV intelligence · published by Reynard</p>
  <h1>The last inch of high voltage.</h1>
  <p class="intro">
    High Voltage Insights covers HV cable termination technology — stress cones, field
    grading materials, and the standards that govern them — for engineers who want the
    material chemistry and test data, not marketing copy.
  </p>

  <h2 class="section-heading">Latest coverage</h2>
  <ul class="article-list">
    {articles.map((article) => (
      <li>
        <a class="row" href={`/articles/${article.slug}/`}>
          {article.data.image && (
            <img class="thumb" src={article.data.image} alt="" width="120" height="63" loading="lazy" />
          )}
          <span class="text">
            <span class="category">{article.data.category}</span>
            <span class="title">{article.data.title}</span>
            <p>{article.data.description}</p>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7C6BFF;
    margin: 0 0 12px;
  }
  h1 {
    font-size: clamp(38px, 6vw, 60px);
    margin: 0 0 20px;
  }
  .intro { max-width: 60ch; color: #A6AFBE; font-size: 1.05rem; }
  .section-heading {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #A6AFBE;
    margin: 44px 0 4px;
    border: none;
  }
  .article-list { list-style: none; padding: 0; margin: 16px 0 0; }
  .article-list li { padding: 18px 0; border-bottom: 1px solid #1C222E; }
  .row { display: flex; align-items: flex-start; gap: 16px; text-decoration: none; }
  .thumb {
    flex-shrink: 0;
    width: 120px;
    height: 63px;
    object-fit: cover;
    border: 1px solid #1C222E;
    border-radius: 3px;
  }
  .text { flex: 1; }
  .category {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #38E8D4;
    margin-bottom: 4px;
  }
  .title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    color: #F2F5F8;
    display: block;
  }
  .article-list p { margin: 6px 0 0; color: #A6AFBE; font-size: 0.95rem; }
</style>
