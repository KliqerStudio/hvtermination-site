---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page Not Found"
  seoTitle="Page Not Found | High Voltage Insights"
  description="This page doesn't exist. Browse our high-voltage cable termination coverage instead."
>
  <p class="code">404</p>
  <h1>That page has gone to ground.</h1>
  <p class="intro">
    The page you're looking for doesn't exist or has moved. Try the
    <a href="/articles/">full article index</a> or head back to the
    <a href="/">homepage</a>.
  </p>
</Layout>

<style>
  .code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: #7C6BFF;
    margin: 0 0 12px;
  }
  h1 { font-size: clamp(30px, 5vw, 44px); margin: 0 0 16px; }
  .intro { max-width: 55ch; color: #A6AFBE; font-size: 1.05rem; }
  .intro a { color: #38E8D4; }
</style>
